{
  // Cloudflare Workers (free plan) config. Deployed by Workers Builds with `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-advisor",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Logo, favicon and touch icon. Served straight from the edge; everything else reaches the Durable Object.
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "ADVISOR", "class_name": "Advisor" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Advisor"] }],
  // Pre-build every league and run automatic lineup management: Thursday, Saturday and Sunday at 12:00 UTC (8am ET),
  // plus a last pass before Thursday night (22:00 UTC, 6pm ET) and before the Sunday 1pm games (16:00 UTC, noon ET).
  "triggers": { "crons": ["0 12 * * THU,SAT,SUN", "0 22 * * THU", "0 16 * * SUN"] }
}
