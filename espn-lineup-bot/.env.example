# Copy this file to .env and fill it in. Never commit .env.

# From your league URL: https://fantasy.espn.com/football/league?leagueId=XXXXXX
LEAGUE_ID=

# Private leagues need these two cookies from fantasy.espn.com while logged in.
# Chrome: F12 > Application > Cookies > https://fantasy.espn.com > copy the values.
# Keep the curly braces on SWID. They expire every so often; re-copy when the tool says it can't load the league.
ESPN_S2=
SWID=

# Optional. The tool matches SWID to your team automatically; set this if it can't.
TEAM_ID=

# Optional. Defaults to the current NFL season.
SEASON=
