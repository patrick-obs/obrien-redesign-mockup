# Command-line tool config. Copy to .env and fill in. Never commit .env.
# The web app does not read this file; it uses environment variables (see README).

# From your league URL: https://fantasy.espn.com/football/league?leagueId=XXXXXX
LEAGUE_ID=

# Private leagues need these two cookies from fantasy.espn.com while logged in.
# Chrome: F12 > Application > Cookies > https://fantasy.espn.com > copy the values.
# Keep the curly braces on SWID. They expire every so often.
ESPN_S2=
SWID=

# Optional. Your team is matched from SWID automatically; set this if it can't be.
TEAM_ID=

# Optional. Defaults to the current NFL season.
SEASON=
